# URL da sua API Backend
VITE_API_URL=http://localhost:5000/api

# Chaves de serviços de geocodificação
VITE_GOOGLE_MAPS_KEY=SUA_CHAVE_AQUI
VITE_OPENROUTE_KEY=SUA_CHAVE_AQUI

# Provedor padrão: nominatim | openrouteservice | google
VITE_GEO_PROVIDER=nominatim

# Chave TomTom Orbis para satélite e trânsito. Preencha em .env.local.
# Autorize somente os domínios da aplicação na chave usada pelo navegador.
VITE_TOMTOM_API_KEY=

# Provedor alternativo. URLs de imagens XYZ com {z}, {x} e {y}, acessíveis pelo navegador.
# Use apenas credenciais públicas restritas ao domínio da aplicação.
VITE_MAP_SATELLITE_TILE_URL=
VITE_MAP_SATELLITE_ATTRIBUTION=
VITE_MAP_TRAFFIC_TILE_URL=
VITE_MAP_TRAFFIC_ATTRIBUTION=
