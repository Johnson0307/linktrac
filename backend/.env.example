PORT=5000
# Se estiver usando docker-compose local, use:
# MONGO_URI=mongodb://mongo:27017/linktrac-db
MONGO_URI=******seu_cluster.mongodb.net/link-prime-db
FRONTEND_URL=http://localhost:5173
JWT_SECRET=troque_para_uma_chave_secreta
JWT_EXPIRES_IN=8h
# ID da empresa Linktrac no banco. Somente admins desta empresa gerenciam espelhamentos.
LINKTRAC_CLIENT_ID=
# E-mail sugerido na configuração local (nenhuma senha é salva aqui).
LINKTRAC_ADMIN_EMAIL=
# Código opcional para proteger a criação inicial de clientes/usuários
REGISTER_SECRET=troque_para_codigo_de_registro
# Token opcional para autenticar dispositivos que enviam telemetria
DEVICE_API_TOKEN=troque_para_token_de_dispositivo

# Opcional: caminho absoluto para uma base TAC licenciada em JSON.
# TAC_BASE_ARQUIVO=C:/dados/linktrac/tac.json

# Opcionais para TMS. Use serviços próprios ou autorizados para dados de entrega.
# TMS_OSRM_URL=http://127.0.0.1:5001/
# OSRM exclusivo para o Mapa Geral. Sem esta configuração, usa o OSRM do TMS quando disponível.
# ROTA_MAPA_OSRM_URL=http://127.0.0.1:5001/
# Caminho para a base local gerada por scripts/importar_fiscalizacao.py.
# FISCALIZACAO_BASE_ARQUIVO=C:/dados/linktrac/fiscalizacao.json
# Alternativa para o Mapa Geral: chave de servidor com TomTom Routing API habilitada.
# ROTA_MAPA_TOMTOM_API_KEY=
# TMS_GEOCODIFICADOR_URL=http://127.0.0.1:8080/

# Opcional. Token exclusivo para POST /api/cliente/briefings/receber (x-briefing-token).
# BRIEFING_INGEST_TOKEN=

# Avisos externos opcionais. Use o ID da empresa autorizada a enviar os próprios alertas.
# ALERTAS_EMPRESA_ID=
# ALERTAS_WEBHOOK_URL=https://seu-integrador.example/alertas
# ALERTAS_WEBHOOK_SEGREDO=
# ALERTAS_RESEND_CHAVE=
# ALERTAS_EMAIL_DE=alertas@seu-dominio-verificado.example
# ALERTAS_EMAIL_PARA=operacao@seu-dominio.example

# Banco separado para arquivo de GPS e telemetria (opcional)
HISTORICO_ARQUIVO_URI=
HISTORICO_ARQUIVO_BANCO=

# Chave persistente do servidor para proteger os tokens bancários (64 dígitos hexadecimais)
FINANCEIRO_CHAVE_CRIPTOGRAFIA=

# WhatsApp Cloud API para alertas de alimentação da empresa ALERTAS_EMPRESA_ID
ALERTAS_WHATSAPP_NUMERO_ID=
ALERTAS_WHATSAPP_TOKEN=
ALERTAS_WHATSAPP_VERSAO=
ALERTAS_WHATSAPP_MODELO=
